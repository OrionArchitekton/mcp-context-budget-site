        "6000",
        "--max-response-tokens",
        "4000"
      ],
      "exit_code": 0,
      "stdout": "DEMO_CATALOG_SERVERS=5\nDEMO_CATALOG_TOOLS=120\nBEFORE_SCHEMA_TOKENS=1837820\nSELECTED_TOOLS=5\nAFTER_SCHEMA_TOKENS=2934\nOVERSIZED_RESPONSE_FIXTURE=flagged\nBUDGET_STATUS=PASS\nSELECTED_TOOL=linear/update_ticket\nSELECTED_TOOL=github/update_issue\nSELECTED_TOOL=github/get_issue\nSELECTED_TOOL=linear/search_ticket\nSELECTED_TOOL=github/list_issue_comments\n",
      "stderr": ""
